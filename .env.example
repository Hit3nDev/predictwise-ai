# Copy to .env (never commit the real one). Everything works without these; they only switch on open-ended chat.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional: pretend today is a fixed date (demos, repeatable tests)
# PW_TODAY=2026-10-12
# Optional: extra allowed browser origins, comma separated
# PW_CORS=

# --- Cloud (set automatically on AWS by infra/3-app.yaml; leave empty locally) ---
# PW_S3_BUCKET=        uploads and models are mirrored to this S3 bucket
# PW_DB_SECRET_ID=     Secrets Manager secret for RDS -> DATABASE_URL
# PW_APP_SECRET_ID=    Secrets Manager secret holding the API keys above
# DATABASE_URL=        or set directly, e.g. postgresql+psycopg2://user:pass@host:5432/predictwise
